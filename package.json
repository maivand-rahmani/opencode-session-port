{
  "name": "opencode-session-port",
  "version": "0.1.7",
  "private": false,
  "license": "MIT",
  "description": "SessionPort: experimental OpenCode TUI plugin for password-encrypted session checkpoint and restore.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/maivand-rahmani/opencode-session-port.git"
  },
  "keywords": [
    "opencode",
    "opencode-plugin",
    "tui",
    "session",
    "checkpoint",
    "restore",
    "encryption"
  ],
  "type": "module",
  "workspaces": [
    "cloud/api",
    "cloud/web"
  ],
  "files": [
    "tui.ts",
    "src/**",
    "dist/**",
    "tsconfig.json"
  ],
  "exports": {
    "./tui": "./dist/tui.js"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "verify:package": "bun run scripts/package-verify/verify.ts",
    "build:tui": "bun run scripts/build-tui.ts",
    "prepack": "bun run build:tui"
  },
  "dependencies": {
    "@opencode/plugin": "2.0.22",
    "libsodium-wrappers-sumo": "0.8.4",
    "pako": "3.0.2"
  },
  "peerDependencies": {
    "@opentui/core": "0.5.14",
    "@opentui/solid": "0.5.14",
    "solid-js": "1.9.12"
  },
  "devDependencies": {
    "@opentui/core": "0.5.14",
    "@opentui/solid": "0.5.14",
    "@types/node": "24.12.2",
    "solid-js": "1.9.12",
    "typescript": "5.9.3"
  }
}
